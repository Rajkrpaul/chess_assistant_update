# ── Backend environment variables ────────────────────────────────────────────
# Copy this to .env.local for local development.
# On Render, set these in the service's Environment tab.

# Absolute path to the Stockfish binary.
# Render Ubuntu: /usr/games/stockfish  (installed via apt)
# Local macOS:   /opt/homebrew/bin/stockfish
# Local Linux:   /usr/games/stockfish  or  /usr/bin/stockfish
STOCKFISH_PATH=/usr/games/stockfish
